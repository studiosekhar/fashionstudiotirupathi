{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/sign-upload", "destination": "/api/sign-upload.js" },
    { "source": "/api/delete-image", "destination": "/api/delete-image.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
